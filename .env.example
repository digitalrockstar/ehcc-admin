# Neon: paste the connection string from the Neon dashboard (postgresql://...?sslmode=require)
DATABASE_URL=sqlite:///./ehcc.db
ADMIN_PASSWORD=change-me
SECRET_KEY=generate-a-long-random-string
APP_ENV=development
# Set to 1 to show full mobile numbers to view-only visitors (default: masked)
SHOW_MOBILE_TO_VIEWERS=0
