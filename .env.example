# Local SQLite is the default. Set an absolute path on EC2, e.g.
# SQLITE_DB_PATH=/opt/apps/EHCC/DB/ehcc-admin.db
SQLITE_DB_PATH=./ehcc.db

# Optional external database: set DATABASE_URL only when you want to use one.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

ADMIN_PASSWORD=change-me
SECRET_KEY=generate-a-long-random-string
APP_ENV=development
# Set to 1 to show full mobile numbers to view-only visitors (default: masked)
SHOW_MOBILE_TO_VIEWERS=0
