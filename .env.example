DATABASE_URL=postgresql://user:password@host/dbname
# leave unset to fall back to local sqlite (dev.db) for local dev

# HTTP Basic Auth for the whole app. If either is left unset, auth is
# skipped entirely - fine for local dev, NOT fine for anything deployed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional: read-only login. Can view every page, blocked (403) from any
# action that creates/edits/deletes data. Leave unset if not needed.
VIEW_ACCESS_USER=
VIEW_ACCESS_PWD=
